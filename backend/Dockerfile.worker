# syntax=docker/dockerfile:1
# The live model service. Build with: docker build -f Dockerfile.worker -t worker .
# The window data is not in the image: mount it at /data (a Cloud Storage bucket on Cloud Run).
ARG GO_VERSION=1.27

# ---- build stage ----
FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src

# Copy module files first so dependency downloads are cached
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# ---- runtime stage ----
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/worker /worker

ENV PORT=8080
ENV DATA_DIR=/data
ENV STREAM_SECONDS=25
ENV MAX_RUNS=2
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/worker"]
