server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend hostname at request time (Cloud Run IPs can change).
    # NGINX_LOCAL_RESOLVERS is filled in from /etc/resolv.conf by the entrypoint.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # Forward /api/* to the backend, stripping the /api prefix.
    # BACKEND_URL must not end with a slash. Host defaults to the backend's
    # own host ($proxy_host), which Cloud Run needs to route the request.
    location /api/ {
        set $backend ${BACKEND_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
